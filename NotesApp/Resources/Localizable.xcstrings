    "Swift Scribe couldn't find a clear subject in this photo." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe konnte in diesem Foto kein eindeutiges Motiv finden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe no encontró un sujeto claro en esta foto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe n’a pas trouvé de sujet net dans cette photo."
          }
        }
      }
    },
    "Swift Scribe couldn't find a clear subject to lift out of this photo. You can use the whole photo as a sticker instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe konnte in diesem Foto kein eindeutiges Motiv zum Freistellen finden. Du kannst stattdessen das ganze Foto als Sticker verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe no encontró un sujeto claro que extraer de esta foto. Puedes usar la foto entera como pegatina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe n’a pas trouvé de sujet net à détacher de cette photo. Vous pouvez utiliser la photo entière comme autocollant."
          }
        }
      }
    },
    "Swift Scribe couldn't write to this device: %@. If you close now, it keeps trying in the background, but changes that haven't been saved are lost if the app quits first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe konnte nicht auf dieses Gerät schreiben: %@. Wenn du jetzt schließt, versucht die App es im Hintergrund weiter. Noch nicht gesicherte Änderungen gehen jedoch verloren, falls die App vorher beendet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe no pudo escribir en este dispositivo: %@. Si cierras ahora, seguirá intentándolo en segundo plano, pero los cambios sin guardar se perderán si la app se cierra antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe n’a pas pu écrire sur cet appareil : %@. Si vous fermez maintenant, l’app continue d’essayer en arrière-plan, mais les modifications non enregistrées seront perdues si elle se ferme avant."
          }
        }
      }
    },
    "Swift Scribe is free and open source. No ads, no subscriptions, no tracking. Your notes stay on your device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe ist kostenlos und Open Source. Keine Werbung, keine Abos, kein Tracking. Deine Notizen bleiben auf deinem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe es gratis y de código abierto. Sin anuncios, sin suscripciones, sin rastreo. Tus notas se quedan en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe est gratuit et open source. Pas de publicité, pas d’abonnement, pas de suivi. Vos notes restent sur votre appareil."
          }
        }
      }
    },
    "Swift Scribe keeps a list of the days you wrote and which pages, on this device only. It's never shared." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe führt nur auf diesem Gerät eine Liste der Tage, an denen du geschrieben hast, und der zugehörigen Seiten. Sie wird nie geteilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe guarda una lista de los días en que escribiste y en qué páginas, solo en este dispositivo. Nunca se comparte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe conserve la liste des jours où vous avez écrit et des pages concernées, sur cet appareil uniquement. Elle n’est jamais partagée."
          }
        }
      }
    },
