          }
        }
      }
    },
    "Tap the microphone to record a lecture or meeting alongside your notes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf das Mikrofon, um eine Vorlesung oder Besprechung parallel zu deinen Notizen aufzunehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el micrófono para grabar una clase o una reunión junto con tus notas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le micro pour enregistrer un cours ou une réunion en même temps que vos notes."
          }
        }
      }
    },
    "Tap the small ribbon beside the page number to bookmark a page. Bookmarks and a PDF's table of contents are listed here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf das kleine Band neben der Seitenzahl, um ein Lesezeichen zu setzen. Lesezeichen und das Inhaltsverzeichnis eines PDFs werden hier aufgelistet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca la cinta pequeña junto al número de página para añadir un marcador. Aquí aparecen los marcadores y la tabla de contenido de un PDF."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le petit ruban à côté du numéro de page pour ajouter un signet à une page. Les signets et la table des matières d’un PDF sont répertoriés ici."
          }
        }
      }
    },
    "Taped Grid Note" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karozettel mit Klebeband"
