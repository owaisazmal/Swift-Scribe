          }
        }
      }
    },
    "Stickers sit under your ink, so you can write on a note or a label. Touch and hold one on the page to move, resize or remove it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sticker liegen unter deiner Tinte, sodass du auf einen Zettel oder ein Etikett schreiben kannst. Halte einen Sticker auf der Seite gedrückt, um ihn zu bewegen, seine Größe zu ändern oder ihn zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pegatinas quedan debajo de la tinta, así que puedes escribir sobre una nota o una etiqueta. Mantén pulsada una en la página para moverla, cambiar su tamaño o quitarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autocollants se placent sous votre encre : vous pouvez donc écrire sur une note ou une étiquette. Maintenez le doigt sur un autocollant de la page pour le déplacer, le redimensionner ou le retirer."
          }
        }
      }
    },
