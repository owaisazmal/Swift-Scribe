      }
    },
    "Tapping the link saves this notebook, puts it away and opens the other one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch Tippen auf den Link wird dieses Notizbuch gesichert und weggelegt und das andere geöffnet."
