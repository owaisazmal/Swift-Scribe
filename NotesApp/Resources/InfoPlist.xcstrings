{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleDisplayName" : {
      "comment" : "Bundle display name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swift Scribe"
          }
        }
      }
    },
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "NotesApp"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe liest die heutigen Termine, um sie auf eine Seite zu drucken, wenn du darum bittest. Sie werden auf diesem iPad gelesen und gelangen nirgendwo anders hin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swift Scribe reads today's events to print them on a page when you ask it to. They are read on this iPad and go nowhere else."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe lee los eventos de hoy para imprimirlos en una página cuando se lo pides. Se leen en este iPad y no van a ningún otro sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe lit les événements du jour pour les imprimer sur une page lorsque vous le demandez. Ils sont lus sur cet iPad et ne vont nulle part ailleurs."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe verwendet die Kamera, um Papier in deine Notizbücher zu scannen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swift Scribe uses the camera to scan paper into your notebooks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe usa la cámara para escanear papel en tus cuadernos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe utilise l’appareil photo pour numériser du papier dans vos carnets."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe verwendet Face ID, um die Notizbücher zu öffnen, die du gesperrt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swift Scribe uses Face ID to open the notebooks you have locked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe usa Face ID para abrir los cuadernos que has bloqueado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe utilise Face ID pour ouvrir les carnets que vous avez verrouillés."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe nimmt Audio parallel zu deinen Notizen auf, wenn du auf die Aufnahmetaste tippst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swift Scribe records audio alongside your notes when you tap the record button."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe graba audio junto con tus notas cuando tocas el botón de grabar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe enregistre l’audio en même temps que vos notes lorsque vous touchez le bouton d’enregistrement."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe sichert die von dir exportierten Bilder und Videos in deiner Fotomediathek, wenn du das auswählst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swift Scribe saves the pictures and videos you export to your photo library when you choose to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe guarda en tu fototeca las imágenes y los vídeos que exportas cuando tú lo eliges."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe enregistre dans votre photothèque les images et les vidéos que vous exportez lorsque vous le choisissez."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe fügt von dir ausgewählte Fotos als Seiten oder Bilder in deine Notizbücher ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swift Scribe adds photos you pick as pages or pictures in your notebooks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe añade las fotos que eliges como páginas o imágenes en tus cuadernos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe ajoute les photos que vous choisissez comme pages ou images dans vos carnets."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe schreibt auf, was in einer Aufnahme gesagt wurde, wenn du darum bittest. Das geschieht auf diesem iPad; die Aufnahme wird nie irgendwohin gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swift Scribe writes down what was said in a recording when you ask it to. It is done on this iPad; the recording is never sent anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe pone por escrito lo que se dijo en una grabación cuando se lo pides. Se hace en este iPad; la grabación nunca se envía a ningún sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Scribe met par écrit ce qui a été dit dans un enregistrement lorsque vous le demandez. Tout se fait sur cet iPad ; l’enregistrement n’est jamais envoyé nulle part."
          }
        }
      }
    },
